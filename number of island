class Solution {
public:

    void dfs(vector<vector<char>>& grid, int r, int c) {

        // Check boundary and water
        if (r < 0 || c < 0 ||
            r >= grid.size() || c >= grid[0].size() ||
            grid[r][c] == '0') {
            return;
        }

        // Mark this land as visited
        grid[r][c] = '0';

        // Go up
        dfs(grid, r - 1, c);

        // Go down
        dfs(grid, r + 1, c);

        // Go left
        dfs(grid, r, c - 1);

        // Go right
        dfs(grid, r, c + 1);
    }

    int numIslands(vector<vector<char>>& grid) {

        int count = 0;

        for (int r = 0; r < grid.size(); r++) {
            for (int c = 0; c < grid[0].size(); c++) {

                if (grid[r][c] == '1') {

                    // Found a new island
                    count++;

                    // Visit the complete island
                    dfs(grid, r, c);
                }
            }
        }

        return count;
    }
};
