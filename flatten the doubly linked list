class Solution {
public:
    Node* flatten(Node* head) {

        if (head == NULL)
            return NULL;

        Node* curr = head;

        while (curr != NULL) {

            if (curr->child != NULL) {

                Node* next = curr->next;

                curr->next = flatten(curr->child);
                curr->next->prev = curr;
                curr->child = NULL;

                Node* tail = curr;

                while (tail->next != NULL) {
                    tail = tail->next;
                }

                tail->next = next;

                if (next != NULL)
                    next->prev = tail;
            }

            curr = curr->next;
        }

        return head;
    }
};
